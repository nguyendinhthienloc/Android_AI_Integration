<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/ocr_back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/baseline_arrow_back_24"
                app:tint="@color/ink_navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recognized_text"
                    android:textColor="@color/ink_navy_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_before_export"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/offline_chip_background"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/offline"
                android:textColor="@color/ink_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ocr_source_preview"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/preview_background"
            android:contentDescription="@string/ocr_source_preview"
            android:padding="6dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/ocr_metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/character_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/recognized_text"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginHorizontal="16dp"
            android:autofillHints=""
            android:background="@drawable/ocr_text_background"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/ink_navy_dark"
            android:textColorHint="@color/ink_muted"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp">

            <Button
                android:id="@+id/save_text_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/save_as_txt"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <Button
                android:id="@+id/copy_text_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/copy"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/recognize_again_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/recognize_again"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>